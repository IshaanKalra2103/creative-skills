// fx: Ripples
// kind: generator
// from: shader-effects-inc/shaders packages/core/src/shaders/Ripples (MIT)
// about: concentric rings pulsing outward from a point, two flat colors; a hypnotic target, a sonar/pulse backdrop, or a ring wipe matte.
// uniform: uCenter float2 0.5 0.5
// uniform: uColorA color #ffffff
// uniform: uColorB color #000000
// uniform: uSpeed float 1.0
// uniform: uFrequency float 20.0
// uniform: uSoftness float 0
// uniform: uThickness float 0.5
// uniform: uPhase float 0
// note: uCenter is in uv with y down (0,0 = top left). Upstream's smoothstep collapses to a
//       hard step at softness 0; this port adds ~1 px of analytic anti-aliasing on top of
//       uSoftness so the default rings do not alias.
uniform float3 iResolution;
uniform float iTime;
uniform float2 uCenter;
uniform float4 uColorA;
uniform float4 uColorB;
uniform float uSpeed;
uniform float uFrequency;
uniform float uSoftness;
uniform float uThickness;
uniform float uPhase;

float3 lin(float3 c) { return mix(c / 12.92, pow((c + 0.055) / 1.055, float3(2.4)), step(0.04045, c)); }
float3 toSrgb(float3 c) { c = clamp(c, 0.0, 1.0); return mix(c * 12.92, 1.055 * pow(c, float3(1.0 / 2.4)) - 0.055, step(0.0031308, c)); }

float4 mixColors(float4 a, float4 b, float t) {
    float wA = a.a * (1.0 - t);
    float wB = b.a * t;
    float sum = wA + wB;
    return float4((a.rgb * wA + b.rgb * wB) / max(sum, 0.001), sum);
}

half4 main(float2 coord) {
    float2 uv = coord / iResolution.xy;
    float aspect = iResolution.x / max(iResolution.y, 1e-6);
    float animTime = iTime * uSpeed;

    // ripplesMask
    float dx = (uv.x - uCenter.x) * aspect;
    float dy = uv.y - uCenter.y;
    float dist = length(float2(dx, dy));
    float waveInput = dist * uFrequency - animTime + uPhase;
    float baseWave = sin(waveInput);
    // One pixel of the wave's slope (stands in for the hard step's missing AA).
    float aa = 0.75 * uFrequency * abs(cos(waveInput)) / iResolution.y + 1e-4;
    float thr = uThickness * 2.0 - 1.0;
    float e = uSoftness + aa;
    float mask = 1.0 - smoothstep(thr - e, thr + e, baseWave);

    // strokeOver: fill colorB, stroke colorA, alpha-weighted in linear light.
    float4 c = mixColors(float4(lin(uColorB.rgb), uColorB.a), float4(lin(uColorA.rgb), uColorA.a), mask);
    float3 rgb = toSrgb(c.rgb);
    return half4(half3(rgb * c.a), half(c.a));
}
