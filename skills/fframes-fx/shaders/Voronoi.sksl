// fx: Voronoi
// kind: generator
// from: shader-effects-inc/shaders packages/core/src/shaders/Voronoi (MIT)
// about: drifting cellular tiles, each glowing from its center color out to an edge color, with thin boundary lines; stained glass, cells, cracked-tile backdrops.
// uniform: uColorA color #3186cf
// uniform: uColorB color #fc02dd
// uniform: uColorBorder color #000000
// uniform: uScale float 6
// uniform: uSpeed float 0.5
// uniform: uSeed float 0
// uniform: uEdgeIntensity float 0.5
// uniform: uEdgeSoftness float 0.05
// note: colorSpace fixed to the default `linear`; the `stops` multi-stop ramp is not ported.
//       The cell hash is upstream's sin-fract hash (same formula; sin precision at large
//       arguments varies by GPU, so the exact cell layout can differ).
uniform float3 iResolution;
uniform float iTime;
uniform float4 uColorA;
uniform float4 uColorB;
uniform float4 uColorBorder;
uniform float uScale;
uniform float uSpeed;
uniform float uSeed;
uniform float uEdgeIntensity;
uniform float uEdgeSoftness;

float3 lin(float3 c) { return mix(c / 12.92, pow((c + 0.055) / 1.055, float3(2.4)), step(0.04045, c)); }
float3 toSrgb(float3 c) { c = clamp(c, 0.0, 1.0); return mix(c * 12.92, 1.055 * pow(c, float3(1.0 / 2.4)) - 0.055, step(0.0031308, c)); }

float2 cellHash2(float2 p) {
    float2 h = float2(dot(p, float2(127.1, 311.7)), dot(p, float2(269.5, 183.3)));
    return fract(sin(h) * 43758.5453);
}

float4 mixColors(float4 a, float4 b, float t) {
    float wA = a.a * (1.0 - t);
    float wB = b.a * t;
    float sum = wA + wB;
    return float4((a.rgb * wA + b.rgb * wB) / max(sum, 0.001), sum);
}

half4 main(float2 coord) {
    float2 uv = coord / iResolution.xy;
    float aspect = iResolution.x / max(iResolution.y, 1e-6);
    float animT = iTime * uSpeed;
    float2 p = float2(uv.x * aspect, uv.y) * uScale;

    // voronoiNearest2: nearest two drifting cell points.
    float2 cell = floor(p);
    float2 local = fract(p);
    float d1 = 10.0;
    float d2 = 10.0;
    for (int ny = -1; ny <= 1; ny++) {
        for (int nx = -1; nx <= 1; nx++) {
            float2 o = float2(float(nx), float(ny));
            float2 h = cellHash2(cell + o + uSeed);
            float px = clamp(h.x + sin(animT + h.x * 6.2831853) * 0.15, 0.05, 0.95);
            float py = clamp(h.y + cos(animT * 0.7 + h.y * 6.2831853) * 0.15, 0.05, 0.95);
            float dd = length(local - (o + float2(px, py)));
            d2 = min(d2, max(dd, d1));
            d1 = min(d1, dd);
        }
    }

    // cellFill: F1/F2 ratio raised to a power set by edgeIntensity.
    float power = 4.0 - uEdgeIntensity * 3.0;
    float ratio = clamp(d1 * 2.0 / max(d1 + d2, 0.0001), 0.0, 1.0);
    float fill = clamp(pow(ratio, power), 0.0, 1.0);
    float4 base = mixColors(float4(lin(uColorA.rgb), uColorA.a), float4(lin(uColorB.rgb), uColorB.a), fill);

    // cellBorders + borderOverlay.
    float soft = uEdgeSoftness * uScale / 6.0;
    float edge = (d2 - d1) / max(d1 + d2, 0.0001);
    float mask = smoothstep(0.0, soft + 0.001, edge);
    float3 rgb = mix(lin(uColorBorder.rgb), base.rgb, mask);

    rgb = toSrgb(rgb);
    return half4(half3(rgb * base.a), half(base.a));
}
