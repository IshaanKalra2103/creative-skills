// fx: Swirl
// kind: generator
// from: shader-effects-inc/shaders packages/core/src/shaders/Swirl (MIT)
// about: two colors folded into each other by three layers of domain-warped sine flow, with a faint shimmer; soft liquid gradient backgrounds, ad-style color washes.
// uniform: uColorA color #1275d8
// uniform: uColorB color #e19136
// uniform: uSpeed float 1
// uniform: uDetail float 1
// uniform: uBlend float 50
// note: colorSpace fixed to the default `linear`; the `stops` multi-stop ramp is not ported.
//       Like upstream, the flow is evaluated on the raw 0..1 uv (not aspect-corrected), so it
//       stretches with the canvas. uBlend 0..100 skews toward colorA (low) or colorB (high).
uniform float3 iResolution;
uniform float iTime;
uniform float4 uColorA;
uniform float4 uColorB;
uniform float uSpeed;
uniform float uDetail;
uniform float uBlend;

float3 lin(float3 c) { return mix(c / 12.92, pow((c + 0.055) / 1.055, float3(2.4)), step(0.04045, c)); }
float3 toSrgb(float3 c) { c = clamp(c, 0.0, 1.0); return mix(c * 12.92, 1.055 * pow(c, float3(1.0 / 2.4)) - 0.055, step(0.0031308, c)); }

float4 mixColors(float4 a, float4 b, float t) {
    float wA = a.a * (1.0 - t);
    float wB = b.a * t;
    float sum = wA + wB;
    return float4((a.rgb * wA + b.rgb * wB) / max(sum, 0.001), sum);
}

// flowLayers: three successively warped sine layers, signed about -1..1.
float flowLayers(float2 uv, float detail, float t) {
    float f1 = detail;
    float2 d1 = float2(
        uv.x + (sin(uv.y * (f1 * 1.7) + t * 0.8) * 0.12 + cos(uv.x * (f1 * 0.9) - t * 0.5) * 0.05),
        uv.y + (cos(uv.x * (f1 * 1.3) - t * 0.6) * 0.12 + sin(uv.y * (f1 * 1.1) + t * 0.7) * 0.05));
    float p1 = sin(d1.x * (f1 * 2.1) + d1.y * (f1 * 1.8) + t * 0.4);

    float f2 = detail * 2.1;
    float2 d2 = float2(
        d1.x + (cos(d1.y * (f2 * 2.7) - t * 0.45) * 0.07 + sin(d1.x * (f2 * 1.9) + t * 0.6) * 0.04),
        d1.y + (sin(d1.x * (f2 * 2.3) + t * 0.65) * 0.07 + cos(d1.y * (f2 * 1.6) - t * 0.4) * 0.04));
    float p2 = cos(d2.x * (f2 * 1.4) - d2.y * (f2 * 1.9) + t * 0.35);

    float f3 = detail * 3.7;
    float2 d3 = float2(
        d2.x + (sin(d2.y * (f3 * 1.8) + t * 0.85) * 0.04 + cos(d2.x * (f3 * 1.3) - t * 0.55) * 0.025 + sin((d2.x + d2.y) * (f3 * 0.7) + t * 0.9) * 0.02),
        d2.y + (cos(d2.x * (f3 * 1.6) - t * 0.75) * 0.04 + sin(d2.y * (f3 * 1.1) + t * 0.5) * 0.025 + cos((d2.x + d2.y) * (f3 * 0.8) - t * 0.95) * 0.02));
    float p3 = sin(d3.x * (f3 * 1.1) + d3.y * (f3 * 1.5) - t * 0.55);

    return p1 * 0.45 + p2 * 0.35 + p3 * 0.2;
}

half4 main(float2 coord) {
    float2 uv = coord / iResolution.xy;
    float t = iTime * uSpeed;
    float pattern = flowLayers(uv, uDetail, t);

    // threshold: unit-normalize, bias by blend (+-0.3), smoothstep 0.3..0.7.
    float bias = (uBlend - 50.0) * 0.006;
    float k = smoothstep(0.3, 0.7, pattern * 0.5 + 0.5 + bias);
    float4 c = mixColors(float4(lin(uColorA.rgb), uColorA.a), float4(lin(uColorB.rgb), uColorB.a), k);

    // shimmered: the whole color (alpha too) times a subtle pattern-driven pulse.
    c *= sin(t * 2.5 + pattern * 8.0) * 0.015 + 1.0;
    float a = clamp(c.a, 0.0, 1.0);
    float3 rgb = toSrgb(c.rgb);
    return half4(half3(rgb * a), half(a));
}
