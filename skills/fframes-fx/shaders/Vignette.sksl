// fx: Vignette
// kind: filter
// from: shader-effects-inc/shaders packages/core/src/shaders/Vignette (MIT)
// about: darkens (or tints) the frame edges toward uColor with a round, aspect-corrected falloff;
//        the classic "pull the eye to the centre" pass over footage or stills.
// uniform: uColor color #000000
// uniform: uCenter float2 0.5 0.5
// uniform: uRadius float 0.5
// uniform: uFalloff float 0.5
// uniform: uIntensity float 1
// note: exact chain: fields.radialFalloffMask (distance in height units, x scaled by aspect)
//       -> colorMixing.mixToward in linear RGB, alpha untouched. uCenter is top-left origin uv.
uniform float3 iResolution;
uniform float iTime;
uniform shader uSrc;
uniform float2 uSrcSize;
uniform float4 uColor;
uniform float2 uCenter;
uniform float uRadius;
uniform float uFalloff;
uniform float uIntensity;

float3 lin(float3 c) { return mix(c / 12.92, pow((c + 0.055) / 1.055, float3(2.4)), step(0.04045, c)); }
float3 toSrgb(float3 c) { c = clamp(c, 0.0, 1.0); return mix(c * 12.92, 1.055 * pow(c, float3(1.0 / 2.4)) - 0.055, step(0.0031308, c)); }

half4 main(float2 coord) {
    float2 uv = coord / iResolution.xy;
    float aspect = iResolution.x / iResolution.y;
    half4 src = uSrc.eval(uv * uSrcSize);
    float a = float(src.a);
    float3 rgb = a > 0.0 ? lin(float3(src.rgb) / a) : float3(0.0);

    float dist = length((uv - uCenter) * float2(aspect, 1.0));
    float amount = smoothstep(uRadius, uRadius + uFalloff, dist) * uIntensity;
    rgb = mix(rgb, lin(uColor.rgb), amount);
    return half4(half3(toSrgb(rgb) * a), half(a));
}
