// fx: GradientMap
// kind: filter
// from: shader-effects-inc/shaders packages/core/src/shaders/GradientMap (MIT)
// about: Photoshop-style gradient map: recolors the image by its brightness through a cosine
//        palette (or three custom colors) that slowly scrolls; strength fades it over the original.
// uniform: uPalette float 0
// uniform: uColorLow color #1a0b2e
// uniform: uColorMid color #e94560
// uniform: uColorHigh color #f9ed69
// uniform: uSpeed float 0.15
// uniform: uContrast float 1
// uniform: uBlackPoint float 0
// uniform: uWhitePoint float 1
// uniform: uStrength float 1
// note: uPalette is the compile-time `palette` select as an index: 0 rainbow (default), 1 sunset,
//       2 ocean, 3 fire, 4 pastel, 5 neon, 6 custom (uColorLow/Mid/High). Custom mixes in OKLCh,
//       the upstream default colorSpace (plain lerp of L, C, hue in radians, as the kit does);
//       other colorSpace options are not ported. Exact chain: colorOps.gradientMapT (Rec.709 luma
//       of the linear child) -> gradientMapCosine / custom cyclic ramp -> gradientMapCompose.
//       The scroll uses the global clock (iTime x speed), like upstream.
uniform float3 iResolution;
uniform float iTime;
uniform shader uSrc;
uniform float2 uSrcSize;
uniform float uPalette;
uniform float4 uColorLow;
uniform float4 uColorMid;
uniform float4 uColorHigh;
uniform float uSpeed;
uniform float uContrast;
uniform float uBlackPoint;
uniform float uWhitePoint;
uniform float uStrength;

float3 lin(float3 c) { return mix(c / 12.92, pow((c + 0.055) / 1.055, float3(2.4)), step(0.04045, c)); }
float3 toSrgb(float3 c) { c = clamp(c, 0.0, 1.0); return mix(c * 12.92, 1.055 * pow(c, float3(1.0 / 2.4)) - 0.055, step(0.0031308, c)); }

float cbrtS(float x) { return sign(x) * pow(abs(x), 1.0 / 3.0); }

float3 toOklch(float3 rgb) {
    float l = rgb.r * 0.4122214708 + rgb.g * 0.5363325363 + rgb.b * 0.0514459929;
    float m = rgb.r * 0.2119034982 + rgb.g * 0.6806995451 + rgb.b * 0.1073969566;
    float s = rgb.r * 0.0883024619 + rgb.g * 0.2817188376 + rgb.b * 0.6299787005;
    float l_ = cbrtS(l), m_ = cbrtS(m), s_ = cbrtS(s);
    float L = l_ * 0.2104542553 + m_ * 0.7936177850 - s_ * 0.0040720468;
    float A = l_ * 1.9779984951 - m_ * 2.4285922050 + s_ * 0.4505937099;
    float B = l_ * 0.0259040371 + m_ * 0.7827717662 - s_ * 0.8086757660;
    return float3(L, sqrt(A * A + B * B), atan(B, A));
}

float3 fromOklch(float3 lch) {
    float L = lch.x;
    float A = lch.y * cos(lch.z);
    float B = lch.y * sin(lch.z);
    float l_ = L + A * 0.3963377774 + B * 0.2158037573;
    float m_ = L - A * 0.1055613458 - B * 0.0638541728;
    float s_ = L - A * 0.0894841775 - B * 1.2914855480;
    float l = l_ * l_ * l_, m = m_ * m_ * m_, s = s_ * s_ * s_;
    return float3(l * 4.0767416621 - m * 3.3077115913 + s * 0.2309699292,
                  l * -1.2684380046 + m * 2.6097574011 - s * 0.3413193965,
                  l * -0.0041960863 - m * 0.7034186147 + s * 1.7076147010);
}

float3 mixOklch(float3 a, float3 b, float t) { return fromOklch(mix(toOklch(a), toOklch(b), t)); }

half4 main(float2 coord) {
    float2 uv = coord / iResolution.xy;
    half4 src = uSrc.eval(uv * uSrcSize);
    float alpha = float(src.a);
    float3 rgb = alpha > 0.0 ? lin(float3(src.rgb) / alpha) : float3(0.0);

    // gradientMapT
    float luma = dot(rgb, float3(0.2126, 0.7152, 0.0722));
    float range = max(uWhitePoint - uBlackPoint, 0.0001);
    float t = clamp((luma - uBlackPoint) / range, 0.0, 1.0);
    t = clamp((t - 0.5) * uContrast + 0.5, 0.0, 1.0);
    float phase = uSpeed * iTime;

    float3 mapped;
    if (uPalette < 5.5) {
        // Inigo Quilez cosine palettes a + b cos(2pi (c t + d + phase))
        float3 pa = float3(0.5);
        float3 pb = float3(0.5);
        float3 pc = float3(1.0);
        float3 pd = float3(0.0, 0.333, 0.667);
        if (uPalette > 0.5 && uPalette < 1.5) { pd = float3(0.0, 0.1, 0.2); }
        else if (uPalette > 1.5 && uPalette < 2.5) { pd = float3(0.3, 0.2, 0.2); }
        else if (uPalette > 2.5 && uPalette < 3.5) { pd = float3(0.8, 0.9, 0.3); }
        else if (uPalette > 3.5 && uPalette < 4.5) { pb = float3(0.25); pd = float3(0.0, 0.25, 0.5); }
        else if (uPalette > 4.5) { pc = float3(2.0, 1.0, 1.0); pd = float3(0.5, 0.2, 0.25); }
        mapped = clamp(pa + pb * cos(6.28318530718 * (pc * t + pd + phase)), 0.0, 1.0);
    } else {
        // custom cyclic ramp low -> mid -> high -> low, scrolled by phase
        float t3 = fract(t + phase) * 3.0;
        float fr = fract(t3);
        float i = floor(t3);
        float3 lo = lin(uColorLow.rgb);
        float3 mi = lin(uColorMid.rgb);
        float3 hi = lin(uColorHigh.rgb);
        if (i < 1.0) { mapped = mixOklch(lo, mi, fr); }
        else if (i < 2.0) { mapped = mixOklch(mi, hi, fr); }
        else { mapped = mixOklch(hi, lo, fr); }
    }

    rgb = mix(rgb, mapped, uStrength);
    return half4(half3(toSrgb(rgb) * alpha), half(alpha));
}
