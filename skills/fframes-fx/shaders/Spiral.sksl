// fx: Spiral
// kind: generator
// from: shader-effects-inc/shaders packages/core/src/shaders/Spiral (MIT)
// about: an Archimedean spiral stroke that turns in place around a center; hypnosis, vortex and "loading" moments, or a rotating background behind a title.
// uniform: uColorA color #000000
// uniform: uColorB color #ffffff
// uniform: uStrokeWidth float 0.5
// uniform: uStrokeFalloff float 0
// uniform: uSoftness float 0
// uniform: uSpeed float 1.0
// uniform: uCenter float2 0.5 0.5
// uniform: uScale float 1.0
// note: colorSpace fixed to the default `linear`. uCenter is in uv with y down. fwidth() is
//       replaced by the analytic pixel derivative of the spiral coordinate (radius + angle
//       terms), which also removes the soft seam along the atan branch cut. uScale = turns per
//       canvas height of radius: the default 1 shows about one turn; the upstream cover is
//       shot near uScale 8 (outside the 0.1..5 slider), so it shows many more turns.
uniform float3 iResolution;
uniform float iTime;
uniform float4 uColorA;
uniform float4 uColorB;
uniform float uStrokeWidth;
uniform float uStrokeFalloff;
uniform float uSoftness;
uniform float uSpeed;
uniform float2 uCenter;
uniform float uScale;

float3 lin(float3 c) { return mix(c / 12.92, pow((c + 0.055) / 1.055, float3(2.4)), step(0.04045, c)); }
float3 toSrgb(float3 c) { c = clamp(c, 0.0, 1.0); return mix(c * 12.92, 1.055 * pow(c, float3(1.0 / 2.4)) - 0.055, step(0.0031308, c)); }

float4 mixColors(float4 a, float4 b, float t) {
    float wA = a.a * (1.0 - t);
    float wB = b.a * t;
    float sum = wA + wB;
    return float4((a.rgb * wA + b.rgb * wB) / max(sum, 0.001), sum);
}

half4 main(float2 coord) {
    float2 uv = coord / iResolution.xy;
    float aspect = iResolution.x / max(iResolution.y, 1e-6);
    float animTime = iTime * uSpeed;
    const float TWO_PI = 6.283185307;

    // spiralOffset
    float dx = (uv.x - uCenter.x) * aspect;
    float dy = uv.y - uCenter.y;
    float l = length(float2(dx, dy));
    float angle = atan(dy, dx) - animTime;
    float offset = l * uScale + angle / TWO_PI;

    // spiralMask
    float stripe = fract(offset);
    float shape = abs(stripe - 0.5) * 2.0;
    float baseWidth = clamp(uStrokeWidth, uStrokeFalloff * 0.005, 1.0);
    float falloffAmount = 1.0 - clamp(uStrokeFalloff, 0.0, 1.0) * l;
    float width = baseWidth * falloffAmount;

    // fwidth(offset): |d offset / d pixel| summed over x and y. Radial term scale/H,
    // angular term 1/(2 pi l H); both rotate with the pixel direction, so |dx|+|dy| <= sqrt2.
    float px = 1.0 / iResolution.y;
    float fw = 1.4142 * px * sqrt(uScale * uScale + 1.0 / (TWO_PI * TWO_PI * max(l * l, 1e-8)));
    float fwMult = 4.0 - smoothstep(0.05, 0.4, uStrokeWidth * 2.0) * smoothstep(0.05, 0.4, (1.0 - uStrokeWidth) * 2.0) * 3.0;
    float pixelSize = mix(fwMult * fw, 2.0 * fw, clamp(fw, 0.0, 1.0));
    float mask = smoothstep(width - pixelSize - uSoftness, width + pixelSize + uSoftness, shape);

    float4 c = mixColors(float4(lin(uColorA.rgb), uColorA.a), float4(lin(uColorB.rgb), uColorB.a), mask);
    float3 rgb = toSrgb(c.rgb);
    return half4(half3(rgb * c.a), half(c.a));
}
