// fx: FractalNoise
// kind: generator
// from: shader-effects-inc/shaders packages/core/src/shaders/FractalNoise (MIT)
// about: billowy fBm clouds (layered gradient noise, each octave drifting its own way) that morph in place; fog, smoke, cloud plates, a luma matte for organic reveals.
// uniform: uColorA color #000000
// uniform: uColorB color #ffffff
// uniform: uOctaves float 4
// uniform: uDetail float 2.0
// uniform: uContrast float 0.5
// uniform: uSpeed float 0.15
// uniform: uAngle float 0
// uniform: uSeed float 0
// note: colorSpace fixed to the default `linear`; the `stops` multi-stop ramp is not ported.
//       uOctaves (1..8) gates a fixed 8-octave loop like upstream. The 2D MaterialX perlin
//       basis uses a float lattice hash instead of the integer Bob Jenkins hash (same gradient
//       set, quintic fade and 0.6616 scale; different random pattern). uAngle is in degrees.
//       The upstream cover has about twice this contrast with clipped blacks, which the current
//       weight-normalized fBm cannot reach at any setting (it looks like an older unnormalized
//       sum); this port follows the current code, so it reads as softer mid-grey clouds.
uniform float3 iResolution;
uniform float iTime;
uniform float4 uColorA;
uniform float4 uColorB;
uniform float uOctaves;
uniform float uDetail;
uniform float uContrast;
uniform float uSpeed;
uniform float uAngle;
uniform float uSeed;

float3 lin(float3 c) { return mix(c / 12.92, pow((c + 0.055) / 1.055, float3(2.4)), step(0.04045, c)); }
float3 toSrgb(float3 c) { c = clamp(c, 0.0, 1.0); return mix(c * 12.92, 1.055 * pow(c, float3(1.0 / 2.4)) - 0.055, step(0.0031308, c)); }

float hash12(float2 p) {
    float3 p3 = fract(float3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    p3 = fract((p3.xxy + p3.yzz) * p3.zyx);
    p3 += dot(p3, p3.zxy + 19.19);
    return fract((p3.x + p3.y) * p3.z);
}

// mx_gradient_float (2D) with the hash reduced to 0..7.
float mxGrad2(float2 i, float2 f) {
    float h = floor(hash12(i) * 8.0);
    float u = h < 4.0 ? f.x : f.y;
    float v = 2.0 * (h < 4.0 ? f.y : f.x);
    float uu = mod(h, 2.0) >= 1.0 ? -u : u;
    float vv = mod(floor(h * 0.5), 2.0) >= 1.0 ? -v : v;
    return uu + vv;
}

// mx_perlin_noise_float (2D): signed.
float mxPerlin2(float2 p) {
    float2 i = floor(p);
    float2 f = p - i;
    float2 w = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);
    float v0 = mxGrad2(i, f);
    float v1 = mxGrad2(i + float2(1, 0), f - float2(1, 0));
    float v2 = mxGrad2(i + float2(0, 1), f - float2(0, 1));
    float v3 = mxGrad2(i + float2(1, 1), f - float2(1, 1));
    return 0.6616 * mix(mix(v0, v1, w.x), mix(v2, v3, w.x), w.y);
}

float4 mixColors(float4 a, float4 b, float t) {
    float wA = a.a * (1.0 - t);
    float wB = b.a * t;
    float sum = wA + wB;
    return float4((a.rgb * wA + b.rgb * wB) / max(sum, 0.001), sum);
}

half4 main(float2 coord) {
    float2 uv = coord / iResolution.xy;
    float aspect = iResolution.x / max(iResolution.y, 1e-6);
    float animTime = iTime * uSpeed;

    // rotatedCenteredDomain
    float a = radians(uAngle);
    float ca = cos(a);
    float sa = sin(a);
    float au = uv.x * aspect - aspect * 0.5;
    float av = uv.y - 0.5;
    float2 base = float2(au * ca + av * sa, -au * sa + av * ca);

    // fbmGated golden-angle sum: base frequency 2, lacunarity = detail, persistence = contrast.
    float2 seedOffset = float2(uSeed, uSeed * 0.7);
    float freq = 2.0;
    float weight = 1.0;
    float acc = 0.0;
    float total = 0.0;
    for (int i = 0; i < 8; i++) {
        float fi = float(i);
        float active = fi < floor(uOctaves) ? 1.0 : 0.0;
        float2 dir = float2(cos(fi * 2.39996323), sin(fi * 2.39996323));
        float2 c = base * freq + animTime * dir + seedOffset;
        acc += mxPerlin2(c) * weight * active;
        total += weight * active;
        freq *= uDetail;
        weight *= uContrast;
    }
    float t = clamp(acc / max(total, 1e-6) * 0.5 + 0.5, 0.0, 1.0);

    float4 col = mixColors(float4(lin(uColorA.rgb), uColorA.a), float4(lin(uColorB.rgb), uColorB.a), t);
    float3 rgb = toSrgb(col.rgb);
    return half4(half3(rgb * col.a), half(col.a));
}
