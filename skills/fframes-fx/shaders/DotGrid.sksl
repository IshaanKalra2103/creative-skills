// fx: DotGrid
// kind: generator
// from: shader-effects-inc/shaders packages/core/src/shaders/DotGrid (MIT)
// about: a lattice of round dots on transparent, with optional brick stagger, per-row drift and twinkle; polka-dot fills, LED walls, starfield-ish backdrops.
// uniform: uColor color #ffffff
// uniform: uDensity float 30
// uniform: uDotSize float 0.3
// uniform: uOffset float 0
// uniform: uSpeed float 0
// uniform: uSpeedVariance float 0.3
// uniform: uTwinkle float 0
// note: output is the dot color with coverage as alpha (transparent between dots), like
//       upstream; put it over a background. The upstream cover is shot at density ~10.
//       Twinkle runs on the global clock (iTime), drift on iTime * uSpeed, as upstream.
uniform float3 iResolution;
uniform float iTime;
uniform float4 uColor;
uniform float uDensity;
uniform float uDotSize;
uniform float uOffset;
uniform float uSpeed;
uniform float uSpeedVariance;
uniform float uTwinkle;

float3 toSrgb(float3 c) { c = clamp(c, 0.0, 1.0); return mix(c * 12.92, 1.055 * pow(c, float3(1.0 / 2.4)) - 0.055, step(0.0031308, c)); }
float3 lin(float3 c) { return mix(c / 12.92, pow((c + 0.055) / 1.055, float3(2.4)), step(0.04045, c)); }

half4 main(float2 coord) {
    float2 uv = coord / iResolution.xy;
    float aspect = iResolution.x / max(iResolution.y, 1e-6);
    float animTime = iTime * uSpeed;

    // aspectCorrectedUVFlipY: rows count up from the bottom edge.
    float2 grid = float2(uv.x * aspect, 1.0 - uv.y) * uDensity;
    float row = floor(grid.y);
    float rowHash = fract(sin(row * 127.1) * 43758.5453);
    float speedMod = 1.0 + (rowHash - 0.5) * 4.0 * uSpeedVariance;
    float drift = animTime * speedMod;
    float stagger = uOffset * (row - 2.0 * floor(row / 2.0));
    float2 shifted = float2(grid.x - stagger - drift, grid.y);
    float2 cell = floor(shifted);
    float2 local = fract(shifted);
    float centerDistance = length(local - 0.5);

    // discCoverage with |fwidth(grid)| as the footprint.
    float pixelSize = 1.4142 * uDensity / iResolution.y;
    float radius = uDotSize * 0.5;
    float coverage = 1.0 - smoothstep(radius - pixelSize * 0.5, radius, centerDistance);

    float dotPhase = fract(sin(cell.x * 12.9898 + cell.y * 78.233) * 43758.5453);
    float twinkleValue = sin(iTime * 2.0 + dotPhase * 6.2831853) * 0.5 + 0.5;
    float alpha = coverage * mix(1.0, twinkleValue, uTwinkle) * uColor.a;

    // withAlpha: straight color + coverage; the color round-trips through linear unchanged.
    float3 rgb = toSrgb(lin(uColor.rgb));
    return half4(half3(rgb * alpha), half(alpha));
}
