// fx: Marble
// kind: generator
// from: shader-effects-inc/shaders packages/core/src/shaders/Marble (MIT)
// about: classic marble: noise-bent sine veins over a base, tone and deep vein color, drifting very slowly; stone surfaces and luxe backdrops.
// uniform: uColorA color #ffffff
// uniform: uColorB color #3a2d54
// uniform: uColorC color #0f0f0f
// uniform: uScale float 2
// uniform: uTurbulence float 10
// uniform: uSpeed float 0.05
// uniform: uSeed float 0
// note: colorSpace fixed to the default `linear`. MaterialX 2D perlin uses a float lattice hash
//       (same 8 gradients, quintic fade, 0.6616 scale), so veins land elsewhere for the same seed.
uniform float3 iResolution;
uniform float iTime;
uniform float4 uColorA;
uniform float4 uColorB;
uniform float4 uColorC;
uniform float uScale;
uniform float uTurbulence;
uniform float uSpeed;
uniform float uSeed;

float3 lin(float3 c) { return mix(c / 12.92, pow((c + 0.055) / 1.055, float3(2.4)), step(0.04045, c)); }
float3 toSrgb(float3 c) { c = clamp(c, 0.0, 1.0); return mix(c * 12.92, 1.055 * pow(c, float3(1.0 / 2.4)) - 0.055, step(0.0031308, c)); }

// Upstream parses hex colors into Display-P3 *linear* numbers but its canvas is plain sRGB, so
// every color shows slightly desaturated (greens most). srgbToP3 reproduces that.
float3 srgbToP3(float3 c) {
    return float3(0.8224621 * c.r + 0.1775380 * c.g,
                  0.0331941 * c.r + 0.9668058 * c.g,
                  0.0170827 * c.r + 0.0723974 * c.g + 0.9105199 * c.b);
}

float hash12(float2 p) {
    float3 p3 = fract(float3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}
// mx_gradient_float (2D) with the hash reduced to 0..7.
float mxGrad2(float2 i, float2 f) {
    float h = floor(hash12(i) * 8.0);
    float u = h < 4.0 ? f.x : f.y;
    float v = 2.0 * (h < 4.0 ? f.y : f.x);
    float uu = mod(h, 2.0) >= 1.0 ? -u : u;
    float vv = mod(floor(h * 0.5), 2.0) >= 1.0 ? -v : v;
    return uu + vv;
}
// mx_perlin_noise_float (2D): signed, roughly -1..1.
float mxPerlin2(float2 p) {
    float2 i = floor(p);
    float2 f = p - i;
    float2 w = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);
    float r = mix(mix(mxGrad2(i, f), mxGrad2(i + float2(1, 0), f - float2(1, 0)), w.x),
                  mix(mxGrad2(i + float2(0, 1), f - float2(0, 1)), mxGrad2(i + float2(1, 1), f - float2(1, 1)), w.x), w.y);
    return 0.6616 * r;
}

half4 main(float2 coord) {
    float2 uv = coord / iResolution.xy;
    float aspect = iResolution.x / max(iResolution.y, 1e-6);
    float t = iTime * uSpeed;
    float seed = uSeed;
    float2 pos = float2(uv.x * aspect, uv.y) * uScale;
    float x = pos.x;
    float y = pos.y;

    // Three decorrelated turbulence octaves drifting on the clock.
    float turbulence = mxPerlin2(float2(x + seed, y + t))
                     + mxPerlin2(float2(x * 2.0 + seed * 1.7, y * 2.0 + t * 0.7)) * 0.5
                     + mxPerlin2(float2(x * 4.0 + seed * 3.1, y * 4.0 + t * 1.3)) * 0.25;
    float vein = sin(x * 3.141592653589793 + turbulence * uTurbulence) * 0.5 + 0.5;
    float depth = mxPerlin2(float2(y * 1.5 + seed * 2.0, x * 1.2)) * 0.3 + 0.5;

    float3 a = srgbToP3(lin(uColorA.rgb));
    float3 b = srgbToP3(lin(uColorB.rgb));
    float3 c = srgbToP3(lin(uColorC.rgb));
    float3 rgb = mix(mix(a, b, smoothstep(0.3, 0.6, vein)), c, smoothstep(0.6, 0.9, vein) * depth);
    return half4(half3(toSrgb(rgb)), 1.0);
}
