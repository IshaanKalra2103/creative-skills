// fx: Halftone
// kind: filter
// from: shader-effects-inc/shaders packages/core/src/shaders/Halftone (MIT)
// about: the image redrawn as a rotated grid of round dots that grow with brightness; transparent between dots.
// uniform: uFrequency float 100
// uniform: uAngle float 45
// note: `style` is compile-time upstream; this port is the default `classic` single-plate screen.
//       The `cmyk` press (four plates, cyan/magenta/yellow/black angles + inks, paper color,
//       misprint) is not ported. `frequency` is dots down the canvas height; brightness is Rec.601
//       on linear light, as upstream.
uniform float3 iResolution;
uniform float iTime;
uniform shader uSrc;
uniform float2 uSrcSize;
uniform float uFrequency;
uniform float uAngle;

float3 lin(float3 c) { return mix(c / 12.92, pow((c + 0.055) / 1.055, float3(2.4)), step(0.04045, c)); }
float3 toSrgb(float3 c) { c = clamp(c, 0.0, 1.0); return mix(c * 12.92, 1.055 * pow(c, float3(1.0 / 2.4)) - 0.055, step(0.0031308, c)); }

half4 main(float2 coord) {
    float2 uv = coord / iResolution.xy;
    half4 s = uSrc.eval(uv * uSrcSize);
    float a = float(s.a);
    float3 rgb = a > 0.0 ? lin(float3(s.rgb) / a) : float3(0.0);

    float2 auv = float2(uv.x * iResolution.x / iResolution.y, uv.y);
    float r = radians(uAngle);
    float c = cos(r);
    float sn = sin(r);
    float2 ruv = float2(dot(auv, float2(c, -sn)), dot(auv, float2(sn, c)));
    float2 g = fract(ruv * uFrequency) - 0.5;

    float brightness = dot(rgb, float3(0.299, 0.587, 0.114));
    float dotSize = brightness * 0.7 + 0.15;
    float dotMask = 1.0 - smoothstep(dotSize - 0.1, dotSize + 0.1, length(g));

    // Upstream multiplies all four (straight) channels by the dot, then the final pass encodes
    // rgb and premultiplies by the (dotted) alpha.
    float outA = a * dotMask;
    return half4(half3(toSrgb(rgb * dotMask) * outA), half(outA));
}
